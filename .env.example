# =========================================================
# StudyOS Backend Environment Configuration Example
# Copy this file to .env and replace placeholders with real values.
# NEVER commit the real .env file or expose credentials.
# =========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (CORS & Same-Site Origin)
CLIENT_URL=http://localhost:5173

# Cookie Security (lax, strict, or none)
COOKIE_SAME_SITE=lax

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=studyos
DB_USER=root
DB_PASSWORD=your_database_password_here

# AI Mentor Service Configuration
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

